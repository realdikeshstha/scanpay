# Copy to .env (or run ./scripts/make-env.sh to generate random values).
# Never commit .env. Use letters and digits only in passwords (they are placed
# in a connection URL).

# Database owner (used only by Postgres initialization and the test suite)
POSTGRES_PASSWORD=replace-with-random-owner-password

# Least-privilege role the application connects as
SCANPAY_DB_APP_PASSWORD=replace-with-random-app-password

# HMAC key that signs merchant QR codes: 64 hex characters.
# Generate with: openssl rand -hex 32
# The app refuses to start while this placeholder is present.
SCANPAY_QR_KEY=replace-with-output-of-openssl-rand-hex-32

# Optional extra names for the self-signed certificate, e.g. to scan from a
# phone on the same Wi-Fi:  SCANPAY_CERT_SAN=IP:192.168.1.20
SCANPAY_CERT_SAN=
